{
  "name": "desktop",
  "private": true,
  "version": "1.0.0",
  "description": "Desktop tracker for Horizon Boost booster order monitoring.",
  "author": "Horizon Boost",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "prebuild": "node scripts/ensure-win-icon.cjs",
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "dev:main": "tsc -p tsconfig.main.json --watch --preserveWatchOutput",
    "dev:electron": "wait-on http://127.0.0.1:5174 file:electron/main.cjs && node scripts/start-electron.cjs",
    "build": "tsc -p tsconfig.main.json && tsc -b && vite build",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:win:portable": "npm run build && electron-builder --win portable --x64",
    "release:win": "npm run build && electron-builder --win nsis --x64 --publish always",
    "verify:release-assets": "node scripts/verify-release-assets.cjs",
    "stage:update-candidate": "node scripts/stage-update-candidate.cjs 1.0.1",
    "serve:update-feed": "node scripts/serve-update-feed.cjs",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "build": {
    "appId": "gg.horizonboost.tracker",
    "productName": "Horizon Boost Tracker",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "electron/preload.cjs",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": true,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Horizon-Boost-Tracker-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Horizon Boost Tracker"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "oRdv",
        "repo": "s-horizon",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "@fontsource/space-grotesk": "^5.2.10",
    "axios": "^1.15.0",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.8.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "png-to-ico": "^3.0.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "wait-on": "^9.0.5"
  }
}
